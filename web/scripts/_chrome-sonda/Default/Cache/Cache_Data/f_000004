<!doctype html>
<html lang="pt-BR" data-loja="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Botané Deli e Café — Reservas</title>
<meta name="description" content="Reserve uma mesa, veja os cardápios e fale com a gente.">
<meta name="theme-color" content="#3C4A3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,600&family=Karla:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap">
<style>
/* ===========================================================================
   O site do CLIENTE — reserva.botanedeliecafe.com.br
   ---------------------------------------------------------------------------
   🔑 **Pedido do dono (21/09/2026):** *"deixa mais próximo ao protótipo que foi
   proposto em `apresentacao/reservas-prototipo.html`, utilizando a logo
   cadastrada, os catálogos colocar tudo na página inicial, no estilo
   apresentado, e ao clicar no botão, abrir o catálogo."*

   ⚠️ **A identidade é a do PROTÓTIPO, linha a linha**: a capa de 128px com os
   dois gradientes radiais sobre o oliva, o medalhão redondo de 92px descendo
   34px por cima dela, a tarja de estado no canto, e a lista de `.item` com
   ícone à esquerda e subtítulo embaixo. As fontes são as de lá — Fraunces para
   os títulos, Karla para o corpo, DM Mono para as miudezas.

   🔑 **Os catálogos são ITENS DA PÁGINA INICIAL**, um por cardápio, e clicar
   abre o PDF. Era uma tela separada com uma lista dentro; o protótipo já os
   mostrava no hub, e é o que o dono pediu de volta.

   ⚠️ **Nada de build.** São duas telas que leem a API — um arquivo que abre
   direto carrega mais rápido no celular de quem está na rua do que qualquer
   bundle, e publica como site estático.
   =========================================================================== */
:root {
  --papel: #F3EFE4;
  --superficie: #FBF9F3;
  --superficie-2: #F7F3E9;
  --tinta: #1B211C;
  --tinta-suave: #5E6659;
  --linha: #E0D8C6;
  --erva: #3C4A3E;
  --ocre-claro: #F6EDD8;
  --barro: #9A3B2E;
  --sombra: 0 1px 2px rgba(27,33,28,.05), 0 10px 30px rgba(27,33,28,.08);
  --raio: 13px;
}
/* ⚠️ O tema escuro vem do APARELHO: quem reserva às 22h está com o celular no
   escuro. Só os tokens mudam — os componentes leem sempre daqui. */
@media (prefers-color-scheme: dark) {
  :root {
    --papel: #12160F; --superficie: #1A1F18; --superficie-2: #202619;
    --tinta: #EDE7D8; --tinta-suave: #9AA394; --linha: #2C3328;
    --ocre-claro: #2A2517;
  }
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body {
  background: var(--papel);
  color: var(--tinta);
  font: 400 15px/1.45 Karla, system-ui, -apple-system, sans-serif;
  -webkit-font-smoothing: antialiased;
}
/* O cartão central, como no protótipo: o site é um folheto, não uma página. */
.folha {
  max-width: 440px; margin: 0 auto; min-height: 100dvh;
  background: var(--superficie); box-shadow: var(--sombra); overflow: hidden;
}
@media (min-width: 480px) {
  body { padding: 24px 16px; }
  .folha { min-height: 0; border: 1px solid var(--linha); border-radius: 18px; }
}

/* ---- a capa ---- */
.capa {
  position: relative; height: 128px;
  background:
    radial-gradient(120% 90% at 30% 20%, #D8C9A8 0%, transparent 60%),
    radial-gradient(110% 90% at 80% 30%, #B7C3A6 0%, transparent 55%),
    linear-gradient(160deg, #6D7A5C, var(--erva));
}
/* 🔑 O medalhão: 92px, redondo, descendo 34px por cima da capa — é a marca da
   casa pousando na dobra. Com logo cadastrada ele vira a imagem; sem ela,
   desenha o nome, como o protótipo. */
.marca {
  position: absolute; left: 50%; bottom: -34px; transform: translateX(-50%);
  width: 92px; height: 92px; border-radius: 50%; background: var(--erva);
  display: grid; place-content: center; text-align: center; color: #F3EFE4;
  border: 3px solid var(--superficie); overflow: hidden;
}
.marca b { display: block; font: 300 21px/1 Fraunces, Georgia, serif; }
.marca span {
  font: 400 8px/1.4 "DM Mono", monospace; letter-spacing: .18em;
  text-transform: uppercase; opacity: .8;
}
.marca img { width: 100%; height: 100%; object-fit: cover; display: block; }
.estado {
  position: absolute; right: 10px; top: 10px; border-radius: 999px;
  padding: 5px 10px; font: 500 11px/1 Karla, sans-serif;
  background: rgba(20,26,22,.72); color: #F1EDE2;
}

/* ---- o corpo ---- */
.corpo { padding: 46px 20px 26px; display: flex; flex-direction: column; gap: 14px; }
.corpo h2 { font: 400 22px/1.2 Fraunces, Georgia, serif; margin: 0; text-align: center; }
.sub { margin: 0; text-align: center; color: var(--tinta-suave); font-size: 14px; }
.rot { display: block; font-size: 13px; font-weight: 500; margin-bottom: 6px; }

.itens { display: flex; flex-direction: column; gap: 9px; }
.item {
  display: flex; align-items: center; gap: 12px; width: 100%; text-align: left;
  background: var(--superficie-2); border: 1px solid var(--linha);
  border-radius: var(--raio); padding: 13px 14px;
  font: 500 15px/1.2 Karla, sans-serif; color: var(--tinta);
  cursor: pointer; text-decoration: none;
  /* ⚠️ 44px de alvo: quem usa este site está no celular, quase sempre andando. */
  min-height: 52px;
}
.item:hover { border-color: var(--erva); }
.item:focus-visible { outline: 2px solid var(--erva); outline-offset: 2px; }
.item .ic { width: 26px; text-align: center; font-size: 17px; flex: none; }
.item small {
  display: block; font-weight: 400; font-size: 12.5px;
  color: var(--tinta-suave); margin-top: 2px;
}
.item.destaque { background: var(--erva); border-color: var(--erva); color: #F4F0E5; }
.item.destaque small { color: rgba(244,240,229,.75); }
.item .fim { margin-left: auto; color: var(--tinta-suave); font-size: 15px; }
.item.destaque .fim { color: rgba(244,240,229,.7); }

.regras {
  background: var(--ocre-claro); border: 1px solid var(--linha);
  border-radius: var(--raio); padding: 12px 14px; font-size: 13px;
  display: flex; flex-direction: column; gap: 6px; color: var(--tinta-suave);
}
.regras b { color: var(--tinta); }
.regras.ruim { background: transparent; border-left: 3px solid var(--barro); border-radius: 0 var(--raio) var(--raio) 0; }

label.campo { display: block; font-size: 13px; color: var(--tinta-suave); }
label.campo input {
  width: 100%; font: 400 15px/1.3 Karla, sans-serif; color: var(--tinta);
  background: var(--superficie); border: 1px solid var(--linha);
  border-radius: 10px; padding: 10px 11px; margin-top: 5px;
}
label.campo input:focus-visible { outline: 2px solid var(--erva); outline-offset: 1px; }
.dupla { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.horarios { display: flex; flex-wrap: wrap; gap: 8px; }
.hora {
  min-height: 44px; min-width: 76px; padding: 8px 14px;
  background: var(--superficie); border: 1px solid var(--linha); border-radius: 10px;
  font: 500 15px/1 "DM Mono", monospace; cursor: pointer; color: inherit;
}
.hora:hover { border-color: var(--erva); }
.hora[aria-pressed="true"] { background: var(--erva); border-color: var(--erva); color: #F4F0E5; }

.voltar {
  background: none; border: 0; color: var(--tinta-suave); cursor: pointer;
  font: 500 13px/1 Karla, sans-serif; padding: 4px 0; align-self: flex-start;
}
.voltar:hover { color: var(--tinta); }
.vazio { color: var(--tinta-suave); font-size: 14px; }
.pe {
  text-align: center; color: var(--tinta-suave);
  font: 400 11.5px/1.6 "DM Mono", monospace; padding: 4px 0 2px;
}
.tela { display: none; }
.tela[data-ativa] { display: flex; flex-direction: column; gap: 14px; }
</style>
</head>
<body>
<div class="folha">

  <header class="capa">
    <span class="estado" id="estado">…</span>
    <div class="marca" id="marca"><b>Botané</b><span>comida de raiz</span></div>
  </header>

  <div class="corpo">

    <!-- ================= a página inicial ================= -->
    <section class="tela" data-tela="inicio" data-ativa>
      <h2 id="nome-da-casa">Botané Deli e Café</h2>
      <p class="sub" id="linha-dias">…</p>
      <div class="itens" id="itens">
        <button class="item destaque" data-ir="reserva">
          <span class="ic" aria-hidden="true">🗓️</span>
          <span>Reservar uma mesa<small>leva menos de um minuto</small></span>
          <span class="fim" aria-hidden="true">›</span>
        </button>
        <!-- 🔑 Os catálogos entram AQUI, um por cardápio, e cada um abre o PDF.
             Quem os monta é o `carregarCatalogos()`. -->
      </div>
    </section>

    <!-- ================= reservar ================= -->
    <section class="tela" data-tela="reserva" aria-labelledby="t-reserva">
      <button class="voltar" data-ir="inicio">‹ voltar</button>
      <h2 id="t-reserva">Reservar uma mesa</h2>
      <!-- 🔑 **As pessoas vêm ANTES do horário, e a ordem é a regra.**
           "Esgotado" depende do tamanho do grupo: às 19h pode não haver mesa
           para 6 e haver para 2. Perguntar o horário primeiro faria a tela
           prometer o que o salão não tem. -->
      <div class="dupla">
        <label class="campo">Quantas pessoas
          <input id="pessoas" type="number" inputmode="numeric" min="1" max="20" value="2">
        </label>
        <label class="campo">Que dia
          <input id="dia" type="date">
        </label>
      </div>
      <div>
        <span class="rot">Horários com mesa</span>
        <div class="horarios" id="horarios" role="group" aria-label="horários disponíveis">
          <span class="vazio">Escolha o dia e quantas pessoas.</span>
        </div>
      </div>
      <div class="regras" id="aviso-reserva" hidden></div>
      <div class="regras">
        <span>⚠️ <b>Esta é a primeira versão.</b> O site mostra os horários que a casa
        tem livres — para confirmar a mesa, a gente fecha pelo WhatsApp.</span>
      </div>
    </section>

    <!-- ================= contato ================= -->
    <section class="tela" data-tela="contato" aria-labelledby="t-contato">
      <button class="voltar" data-ir="inicio">‹ voltar</button>
      <h2 id="t-contato">Entre em contato</h2>
      <div class="itens" id="bloco-contato"></div>
    </section>

    <p class="pe" id="rodape"></p>
  </div>
</div>

<script>
/* ===========================================================================
   ⚠️ **A API é a MESMA do sistema interno.** Não há backend próprio: as rotas
   `/publico/...` existem para isso, e a regra de disponibilidade é a que a
   agenda do balcão usa — uma segunda regra aqui divergiria, e a divergência
   apareceria como mesa prometida ao cliente e não disponível na casa.

   ⚠️ **O endereço é decidido pelo HOSPEDEIRO**, não escrito no código.
   =========================================================================== */
const API = location.hostname === "localhost" || location.hostname === "127.0.0.1"
  ? "http://127.0.0.1:9200"
  : "https://sistema.botanedeliecafe.com.br/api";

/* A loja sai do `<html data-loja>`: no dia em que houver duas casas com
   reserva, cada uma publica o seu com o número dela — sem tocar no código. */
const LOJA = document.documentElement.dataset.loja || "1";

const $ = (s) => document.querySelector(s);
const esc = (t) => String(t ?? "").replace(/[<>&"]/g,
  (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" }[c]));

async function pedir(rota) {
  const r = await fetch(`${API}/publico/${LOJA}${rota}`);
  if (!r.ok) throw new Error(String(r.status));
  return r.json();
}

function ir(nome) {
  document.querySelectorAll(".tela").forEach((t) => {
    if (t.dataset.tela === nome) t.setAttribute("data-ativa", "");
    else t.removeAttribute("data-ativa");
  });
  window.scrollTo({ top: 0, behavior: "smooth" });
  // ⚠️ O botão de VOLTAR do celular precisa funcionar: sem isto, quem está na
  // reserva e volta sai do site em vez de ir para o início.
  if (location.hash !== "#" + nome) history.pushState({ tela: nome }, "", "#" + nome);
}
document.addEventListener("click", (e) => {
  const alvo = e.target.closest("[data-ir]");
  if (!alvo) return;
  e.preventDefault();
  ir(alvo.dataset.ir);
});
window.addEventListener("popstate", () => ir((location.hash || "#inicio").slice(1)));

/* ---- quem é a casa ---- */
let casa = null;

function linkZap(texto) {
  return casa && casa.whatsapp
    ? `https://wa.me/${casa.whatsapp}?text=${encodeURIComponent(texto)}`
    : null;
}

async function carregarCasa() {
  try {
    casa = await pedir("/casa");
  } catch {
    $("#linha-dias").textContent = "Não conseguimos carregar agora. Tente em instantes.";
    $("#estado").hidden = true;
    return;
  }
  $("#nome-da-casa").textContent = casa.casa;
  document.title = `${casa.casa} — Reservas`;

  // 🔑 **A logo CADASTRADA** (pedido do dono). Sem ela, o medalhão desenha o
  // nome da casa, como o protótipo — inventar uma imagem seria pior.
  if (casa.logo_url) {
    $("#marca").innerHTML =
      `<img src="${API}${esc(casa.logo_url)}" alt="${esc(casa.casa)}">`;
  } else {
    const primeiro = (casa.casa || "Botané").split(" ")[0];
    $("#marca").innerHTML = `<b>${esc(primeiro)}</b><span>deli e café</span>`;
  }
  // ⚠️ **A capa NÃO usa `empresa.cor_primaria`, e isso foi medido na tela.** A
  // cor cadastrada é #149445 — um verde vivo, que o sistema interno usa como
  // acento sobre fundo claro. Chapada numa capa de 128px ela briga com o
  // medalhão escuro e afasta o site justamente do protótipo, que é terroso
  // (oliva sobre areia). O pedido foi chegar PERTO do protótipo; o gradiente
  // dele fica.

  // ⚠️ **"Fechado" sozinho é uma porta na cara.** A tarja diz quando abre.
  $("#estado").textContent = casa.aberta_agora
    ? "Aberto agora"
    : casa.proximo ? `Fechado · abre ${casa.proximo}` : "Fechado hoje";
  $("#linha-dias").textContent = (casa.dias || []).length
    ? casa.dias.join(" · ") + (casa.hoje ? ` · hoje ${casa.hoje}` : "")
    : [casa.endereco, casa.cidade && `${casa.cidade}/${casa.uf}`].filter(Boolean).join(" · ");
  $("#rodape").textContent =
    [casa.endereco, casa.cidade && `${casa.cidade}/${casa.uf}`].filter(Boolean).join(" · ");

  montarContato();
  montarPortaDeContato();
}

/* 🔑 O contato é o ÚLTIMO item da lista, como no protótipo. Com número
   cadastrado ele abre o WhatsApp direto; sem, leva à tela com o que existe. */
function montarPortaDeContato() {
  const zap = linkZap(`Olá! Vim pelo site do ${casa ? casa.casa : "Botané"}.`);
  const porta = document.createElement(zap ? "a" : "button");
  porta.className = "item";
  if (zap) {
    porta.href = zap;
    porta.target = "_blank";
    porta.rel = "noopener";
  } else {
    porta.dataset.ir = "contato";
  }
  porta.innerHTML = `<span class="ic" aria-hidden="true">💬</span>
    <span>Entre em contato<small>${zap ? "abrir uma conversa no WhatsApp"
      : "telefone, e-mail e endereço"}</small></span>
    <span class="fim" aria-hidden="true">›</span>`;
  $("#itens").appendChild(porta);
}

function montarContato() {
  const l = [];
  const zap = linkZap(`Olá! Vim pelo site do ${casa.casa}.`);
  if (zap) {
    l.push(`<a class="item" href="${zap}" target="_blank" rel="noopener">
      <span class="ic">💬</span><span>WhatsApp<small>abrir conversa</small></span>
      <span class="fim">›</span></a>`);
  } else {
    // ⚠️ **Sem número cadastrado, o site DIZ isso** em vez de mostrar um botão
    // que não leva a lugar nenhum. O número sai de Administração ▸ Empresa.
    l.push(`<div class="regras ruim">O WhatsApp ainda não está cadastrado. Quem cuida do
      sistema pode preenchê-lo em Administração ▸ Empresa, e ele aparece aqui na hora.</div>`);
  }
  if (casa.telefone) l.push(`<a class="item" href="tel:${esc(casa.telefone)}">
    <span class="ic">☎️</span><span>Telefone<small>${esc(casa.telefone)}</small></span></a>`);
  if (casa.email) l.push(`<a class="item" href="mailto:${esc(casa.email)}">
    <span class="ic">✉️</span><span>E-mail<small>${esc(casa.email)}</small></span></a>`);
  if (casa.endereco) l.push(`<div class="item"><span class="ic">📍</span>
    <span>Onde estamos<small>${esc(casa.endereco)}${casa.cidade
      ? " — " + esc(casa.cidade) + "/" + esc(casa.uf) : ""}</small></span></div>`);
  $("#bloco-contato").innerHTML = l.join("");
}

/* ---- os cardápios, na PÁGINA INICIAL ---- */
const ICONES = ["📖", "🎁", "🧺", "🍰", "🥐"];

async function carregarCatalogos() {
  let lista = [];
  try {
    lista = await pedir("/catalogos");
  } catch {
    return;
  }
  if (!lista.length) return;
  // ⚠️ Entram DEPOIS do "Reservar" e ANTES do contato — a ordem da lista é a
  // ordem de importância, e reservar é o que a casa quer que aconteça.
  const contato = $("#itens").querySelector("a.item, button.item[data-ir='contato']");
  lista.forEach((c, i) => {
    const a = document.createElement("a");
    a.className = "item";
    // 🔑 **Clicar ABRE o catálogo** — o PDF, em outra aba. Era uma tela
    // intermediária com uma lista dentro; agora é um toque.
    a.href = `${API}${c.arquivo_url}`;
    a.target = "_blank";
    a.rel = "noopener";
    a.innerHTML = `<span class="ic" aria-hidden="true">${ICONES[i % ICONES.length]}</span>
      <span>${esc(c.nome)}<small>${c.ate
        ? "até " + new Date(c.ate + "T12:00").toLocaleDateString("pt-BR")
        : "abrir o PDF"}</small></span>
      <span class="fim" aria-hidden="true">›</span>`;
    if (contato) $("#itens").insertBefore(a, contato);
    else $("#itens").appendChild(a);
  });
}

/* ---- os horários que a casa tem livres ---- */
let buscando = null;
async function buscarHorarios() {
  const dia = $("#dia").value;
  const pessoas = Number($("#pessoas").value || 0);
  const caixa = $("#horarios");
  const aviso = $("#aviso-reserva");
  aviso.hidden = true;
  if (!dia || !pessoas) {
    caixa.innerHTML = `<span class="vazio">Escolha o dia e quantas pessoas.</span>`;
    return;
  }
  caixa.innerHTML = `<span class="vazio">Procurando mesa…</span>`;
  // ⚠️ A última busca é a que vale: digitar "12" em "pessoas" dispara duas, e
  // sem isto a resposta do "1" podia chegar depois e mandar na tela.
  const minha = Symbol();
  buscando = minha;
  let r;
  try {
    r = await pedir(`/horarios?dia=${dia}&pessoas=${pessoas}`);
  } catch {
    if (buscando !== minha) return;
    caixa.innerHTML = `<span class="vazio">Não conseguimos consultar agora.</span>`;
    return;
  }
  if (buscando !== minha) return;

  if (!r.horarios.length) {
    caixa.innerHTML = `<span class="vazio">Nenhum horário livre.</span>`;
    aviso.hidden = false;
    aviso.textContent = r.motivo || "Não há mesa para este grupo neste dia.";
    return;
  }
  caixa.innerHTML = r.horarios.map((h) =>
    `<button class="hora" type="button" aria-pressed="false">${esc(h)}</button>`).join("");
  if (r.teto && pessoas > r.teto) {
    aviso.hidden = false;
    aviso.innerHTML = `Para <b>${pessoas} pessoas</b> a casa acerta no WhatsApp.`;
  }
}

$("#horarios").addEventListener("click", (e) => {
  const b = e.target.closest(".hora");
  if (!b) return;
  $("#horarios").querySelectorAll(".hora")
    .forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
  const aviso = $("#aviso-reserva");
  aviso.hidden = false;
  const quando = new Date($("#dia").value + "T12:00").toLocaleDateString("pt-BR");
  const zap = linkZap(
    `Olá! Queria reservar para ${$("#pessoas").value} pessoas no dia ${quando} às ${b.textContent}.`);
  // ⚠️ **A tela não promete o que ainda não faz.** Escolher o horário aqui não
  // grava reserva nenhuma — dizer "reservado" faria o cliente aparecer na porta
  // sem mesa.
  aviso.innerHTML = zap
    ? `Você escolheu <b>${esc(b.textContent)}</b>. Para confirmar,
       <a href="${zap}" target="_blank" rel="noopener">mande a mensagem pronta ›</a>`
    : `Você escolheu <b>${esc(b.textContent)}</b>. Ligue para a casa para confirmar.`;
});

/* ---- começo ---- */
(function inicio() {
  const hojeIso = () => new Date(Date.now() - new Date().getTimezoneOffset() * 60000)
    .toISOString().slice(0, 10);
  const d = new Date();
  d.setDate(d.getDate() + 1);
  $("#dia").value = new Date(d.getTime() - d.getTimezoneOffset() * 60000)
    .toISOString().slice(0, 10);
  $("#dia").min = hojeIso();

  $("#dia").addEventListener("change", buscarHorarios);
  $("#pessoas").addEventListener("input", buscarHorarios);

  carregarCasa().then(carregarCatalogos);
  buscarHorarios();
