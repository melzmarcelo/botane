# ambiente
api/.env
api/__pycache__/
**/__pycache__/
*.pyc

# node / next
web/node_modules/
web/.next/
web/out/
.env.local

# temporários
_debug.html
_shot_*.html
_s_*.png
_p*.png

# imagens enviadas em ambiente local
api/uploads/
# tambem guarda os e-mails gravados em disco quando nao ha SMTP configurado
api/arquivos/

# temporario de comandos longos (o C: nao aguenta)
.tmp/

# saída dos testes de tela
web/scripts/_fotos/
# O relatório da rodada: registro do dia, não código — e ele muda a cada
# execução, então versioná-lo enche o diff sem dizer nada sobre o sistema.
web/scripts/_saida-navegador.txt
# Perfil do Chrome do verificar.mjs — volume, nao codigo. Fica no D: de
# proposito: no TEMP do C: o Chrome falha com erro de PROTOCOLO, nao com
# "disco cheio", e parece instabilidade do teste.
# ⚠️ Com asterisco: as sondas avulsas criam perfis irmãos (`_chrome-perfil3`),
# e um perfil de Chrome são 230 arquivos de cache que não moram em repositório.
# ⚠️ **`_chrome-*`, não `_chrome-perfil*`** (21/09/2026): uma sonda chamou o
# dela de `_chrome-sonda`, escapou do padrão antigo e os 230 arquivos entraram
# num commit. O molde agora pega qualquer nome que comece com `_chrome`.
web/scripts/_chrome-*/
site/_chrome-*/
web/tsconfig.tsbuildinfo

# Dump da base local antes de uma limpeza — volume, nao codigo, e fica no D:
.backup/

# Saida das rodadas de bateria — registro do dia, nao codigo
web/_v*.log
api/_todos.log
api/_api.log

# Log do uvicorn local (o processo segura o arquivo)
_api.log
_api.err

# Rodadas da bateria e log da API deste turno — registro do dia, nao codigo.
# ⚠️ Ficam com ponto na frente de proposito: no D:, fora do que o deploy copia.
web/.bateria*.txt
api/.log-api.txt
api/.log-api.err

# A foto de resgate do `preservar_reserva`: dado da casa, nunca versionado.
api/tests/_foto_reserva_*.json
