# Botané — variáveis do ambiente ONLINE.
#
# Copie para `.env` NO SERVIDOR e preencha. Este arquivo é exemplo: ele fica no
# repositório, o `.env` nunca. É por isso que configuração NÃO se promove por
# merge — cada ambiente tem o seu.
#
#   cp .env.producao.exemplo .env && nano .env
#
# ⚠️ Depois de editar, confira com `python -c "import config"` antes de subir a
# API: erro de variável só aparece no start, e no start já é tarde.

# --- banco -------------------------------------------------------------------
# Postgres gerenciado, não o do próprio servidor: backup e restauração viram
# problema de outra pessoa, e é isso que se quer para o razão da casa.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=botane
# ⚠️ `require` em banco remoto. `prefer` aceita conexão sem TLS se o servidor
# não oferecer — ou seja, aceita justamente o caso em que a senha viaja aberta.
DB_SSLMODE=require

# --- sessão ------------------------------------------------------------------
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ⚠️ ESTE VALOR NÃO SE TROCA DEPOIS. Dele sai a chave que cifra as credenciais
# do Omie e do SMTP guardadas no banco: trocar invalida todas, e elas não
# voltam em claro nem para o administrador. Guarde-o junto com as senhas.
JWT_SECRET=
JWT_EXPIRY_MIN=60
REFRESH_EXPIRY_DIAS=30
MAX_TENTATIVAS_LOGIN=5
BLOQUEIO_MINUTOS=15

# --- servidor ----------------------------------------------------------------
PORT=9200
# ⚠️ `false`. Com DEBUG ligado o erro sai detalhado para quem chamou — inclusive
# para quem está tentando descobrir como o sistema é por dentro.
DEBUG=false

# O domínio de onde o navegador fala com a API. Sem ele na lista, o navegador
# BLOQUEIA o login e a tela fica muda sem dizer por quê — é o primeiro erro de
# todo deploy. Vários separados por vírgula, sem barra no fim.
CORS_ORIGINS=https://botane.exemplo.com.br

# O endereço do sistema, que entra no LINK do e-mail de recuperação de senha.
# Apontando para localhost, o link chega e não abre em lugar nenhum.
WEB_URL=https://botane.exemplo.com.br

SENHA_TOKEN_MINUTOS=30
SENHA_PEDIDOS_HORA=3

# --- primeiro acesso ---------------------------------------------------------
# Só é usado quando a tabela de usuários está VAZIA — na primeira subida. Depois
# disso, mudar aqui não muda nada: o usuário já existe.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador

# --- o que NÃO mora aqui -----------------------------------------------------
# SMTP e as credenciais do Omie ficam no BANCO, cifradas, e se configuram pela
# tela de Integrações. Não há variável de ambiente para elas de propósito:
# segredo em arquivo de configuração é segredo que vaza em backup e em log.

# --- Sessão -----------------------------------------------------------------
# Validade do refresh de quem NÃO marcou "manter conectado" no login. O token
# morre com o navegador (o front guarda em sessionStorage), mas o servidor não
# pode confiar nisso: é esta validade que garante a promessa se alguém copiar o
# token. Um turno de trabalho é a medida certa.
REFRESH_SESSAO_HORAS=12

# Folga para o refresh ROTATIVO. Duas abas apresentam o mesmo token: a primeira
# rotaciona e revoga, e a segunda chegaria com token morto — derrubando a sessão
# de quem não fez nada errado. ⚠️ Vale só para token substituído por rotação;
# logout revoga na hora, sempre. Aumentar isto alarga a janela em que um token
# já rotacionado ainda serve.
REFRESH_GRACA_SEGUNDOS=30
